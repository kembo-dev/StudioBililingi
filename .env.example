# StudioBililingi — copy to .env

POSTGRES_DB=studiobililingi
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000

STUDIO_BACKENDS=stub
STUDIO_TEXT_BACKEND=stub
STUDIO_IMAGE_BACKEND=stub
STUDIO_VIDEO_BACKEND=stub

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
VEO_MODEL=veo-3.1-generate-preview
VEO_TIMEOUT_SECONDS=300

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false

# Google GenAI is not fork-safe in local workers; use solo unless validated otherwise.
CELERY_POOL=solo
